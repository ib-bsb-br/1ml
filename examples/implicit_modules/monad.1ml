import "prelude"
import "../../basis/list.1ml"

type MONAD = {
  type m a
  return 'a : a ~> m a
  bind 'a 'b : m a -> (a ~> m b) ~> m b
}

return [M : MONAD] x = M.return x
(>>=) [M : MONAD] m k = M.bind m k

implicit Monad_option = {
  type m a = Opt.t a
  return x = Opt.some x
  bind x k = Opt.case { none = none, some y = k y} x
}

implicit Monad_list = {
  type m = list
  return x = x :: nil
  bind x k = flatMap k x
}

