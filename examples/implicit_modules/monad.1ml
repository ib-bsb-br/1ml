l : list _ = return 5 >>= fun x => return x

o : opt _ = return 5 >>= fun x => return x

m = (1 :: (2 :: (3 :: nil))) >>= fun x => return x

n = return 5 >>= fun x => (x :: (2 :: (3 :: nil)))

sequence 'a = rec (f: [M : MONAD] -> list (M.m a) ~> M.m (list a)) => 
  fun [M : MONAD] (x : list (M.m a)) => 
    case {nil = return nil, y::ys = y >>= (fun z => f ys >>= fun zs => return (z :: zs)) } x