import "prelude"
import "../../basis/list.1ml"

type SHOW = {
    type t
    show : t ~> text
}

implicit Show_int = {
    type t = int
    show = primitive "Int.toText"
}

implicit Show_bool = {
    type t = bool
    show x = if x then "true" else "false"
}

implicit Show_list1 [S: SHOW] = {
    type t = list S.t
    show x = "[" ++ (toText S.show x) ++ "]"
}

implicit Show_list2 [S: SHOW] = {
    type t = list S.t
    show x = "{" ++ (toText S.show x) ++ "}"
}

show [S: SHOW] x = S.show x

test_ex = show [Show_list1 [Show_int]] (1 :: (2 :: nil))
test = show [Show_list1 [_]] (1 :: (2 :: nil))