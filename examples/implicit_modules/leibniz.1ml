import "../../prelude.1ml"

type T1 = {
    t : (a : type) -> type
}

Eq : {
    type eq a b

    refl 'a : eq a a 
    cast 'a 'b : eq a b ~> a ~> b
    lift 'a 'b : eq a b -> [T : T1] -> eq (T.t a) (T.t b)
    symm 'a 'b : eq a b ~> eq b a
} = {
    implicit Id = {
        type t a = a
    }

    type eq a b = wrap [T : T1] -> T.t a -> T.t b

    refl 'a [T : T1] (x : T.t a) : T.t a = x
    cast 'a 'b (e : eq a b) = e [Id]
    lift 'a 'b (e : eq a b) [T : T1] [U : T1] = let TU = {
        type t c = U.t (T.t c)
    } in e [TU]
    symm 'a 'b (e : eq a b) = let R = {
        type t c = eq c a
    } in lift e [R] [Id] refl
}