import "../../prelude.1ml"

type SHOW = {
    type t
    show : t -> text
}

show [S: SHOW] x = S.show x

implicit Show_int = {
    type t = int
    show = primitive "Int.toText"
}

implicit Show_bool = {
    type t = bool
    show x = if x then "true" else "false"
}

implicit Show_this [S : SHOW] = {
    type t = S.t
    show = S.show
}

test = show 5

do Text.print (test ++ "\n")